<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Biblioteca</title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="encabezado">
        <div class="contenedor">
            <a class="marca" asp-controller="Home" asp-action="Index">Biblioteca</a>
            <nav aria-label="Menú principal">
                <a asp-controller="Autores" asp-action="Index">Autores</a>
                <a asp-controller="Categorias" asp-action="Index">Categorías</a>
                <a asp-controller="Libros" asp-action="Index">Libros</a>
                <a asp-controller="Lectores" asp-action="Index">Lectores</a>
                <a asp-controller="Prestamos" asp-action="Index">Préstamos</a>
            </nav>
        </div>
    </header>

    <main class="contenedor contenido">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <p class="aviso" role="status">@mensaje</p>
        }
        @if (TempData["Error"] is string error)
        {
            <p class="aviso aviso-error" role="alert">@error</p>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
