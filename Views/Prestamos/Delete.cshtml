@model BibliotecaSemana4.Models.Prestamo

@{
    ViewData["Title"] = "Eliminar préstamo";
}

<h1>@ViewData["Title"]</h1>

<p>¿Deseas eliminar este registro?</p>
<dl>
    <dt>
        @Html.DisplayNameFor(model => model.FechaPrestamo)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.FechaPrestamo)
    </dd>
    <dt>
        @Html.DisplayNameFor(model => model.FechaDevolucion)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.FechaDevolucion)
    </dd>
    <dt>
        @Html.DisplayNameFor(model => model.Libro)
    </dt>
    <dd>
        @Model.Libro?.Titulo
    </dd>
    <dt>
        @Html.DisplayNameFor(model => model.Lector)
    </dt>
    <dd>
        @Model.Lector?.Nombre @Model.Lector?.Apellido
    </dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar" class="btn" />
    <a asp-action="Index">Volver al listado</a>
</form>
